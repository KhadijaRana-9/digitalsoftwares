# Supabase project credentials
# Create a project at https://supabase.com, then copy these from
# Project Settings → API. Never commit the real .env file.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# NOT read by the app itself — only used by supabase/seed-demo-users.mjs to
# create the demo Auth accounts. Set it as a local shell/environment
# variable when you run that script, never here in a committed file.
#   Project Settings → API → Project API keys → service_role (secret)
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=
